model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["bridge_title_studio","dim_date","dim_platform","dim_player","dim_studio","dim_title","fact_order","fact_refund","DataFolder"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table bridge_title_studio
ref table dim_date
ref table dim_platform
ref table dim_player
ref table dim_studio
ref table dim_title
ref table fact_order
ref table fact_refund
ref table __Measures

ref cultureInfo en-US

