// =============================================================================
// MEASURES.dax — Twin Hearth Studios analytics layer
//
// Composition: three base measures, everything else built on them. No derived
// measure re-aggregates a fact table; they all compose the bases, so a change to
// how revenue is counted happens in exactly one place.
//
// Date roles: dim_date is the marked date table. fact_order[order_date] and
// fact_refund[order_date] are the ACTIVE relationships (Finance's basis, used by
// six of the seven questions). fact_order[settlement_date] and
// fact_refund[refund_date] are INACTIVE and switched on by USERELATIONSHIP in the
// two cash-basis measures only.
// =============================================================================


// ---------------------------------------------------------------- 1. BASE ----

// Order value already net of the store's cut, recognised on the order date.
// order_status is deliberately NOT filtered: 'refunded' rows carry their full
// original value and are reversed in full by fact_refund. Filtering to
// 'completed' would remove them here and subtract them again below.
Gross Revenue =
SUM ( fact_order[net_usd] )


// Refunds already net of the store's credit. On the active relationship these
// land on the ORIGINAL order date — Finance's basis, per the brief.
Refunds =
SUM ( fact_refund[net_refund_usd] )


// What we keep: order value less refunds. The company's headline number.
Net Revenue =
[Gross Revenue] - [Refunds]


// -------------------------------------------------- 2. CASH (DATE ROLES) ----

// Money that actually landed in the bank in the period: order value moved onto
// its settlement date, 30–60 days after the sale depending on the storefront.
Revenue Settled =
CALCULATE (
    [Gross Revenue],
    USERELATIONSHIP ( dim_date[date], fact_order[settlement_date] )
)


// Refunds as Treasury counts them: on the date the refund was paid out, not the
// date of the order it reverses.
Refunds Paid =
CALCULATE (
    [Refunds],
    USERELATIONSHIP ( dim_date[date], fact_refund[refund_date] )
)


// Net cash movement in the period. Supporting measure only — see the note under
// scorecard Q2 on why the headline cell reports inflows rather than this.
Net Cash Settled =
[Revenue Settled] - [Refunds Paid]


// ------------------------------------------------------------- 3. STUDIO ----

// The payout basis: a co-developed title is credited IN FULL to every studio
// that worked on it, so this deliberately exceeds [Net Revenue] whenever more
// than one studio is in context. Both numbers are correct; they answer different
// questions. Iterating studios forces one credit per studio rather than one per
// order, which is what makes the double-count intentional instead of accidental.
Studio Credited Net Revenue =
SUMX ( VALUES ( dim_studio[studio_id] ), [Net Revenue] )


// The size of that double-count: revenue on co-developed titles, counted more
// than once. Exists so the gap between the two totals above is a labelled
// number on the page instead of an argument in the meeting.
Co-dev Overlap =
[Studio Credited Net Revenue] - [Net Revenue]


// ------------------------------------------------------------ 4. PLAYERS ----

// Distinct players with at least one order whose ORDER DATE falls in the period.
// A player whose only order was fully refunded still counts: they transacted.
Paying Players =
DISTINCTCOUNT ( fact_order[player_id] )


// Net revenue per paying player. Asymmetric on purpose: the numerator is net of
// refunds, the denominator is a headcount that is not. Stated in MODEL.md.
Revenue per Paying Player =
DIVIDE ( [Net Revenue], [Paying Players] )


// ------------------------------------------------------------- 5. GROWTH ----

// Same period, prior fiscal year. Fiscal quarters here align exactly to calendar
// quarters (FY Q1 = Oct–Dec), so a straight year shift is correct.
Net Revenue PY =
CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )


// Growth against the same quarter last year, as a ratio. Format as percentage.
Net Revenue Growth % =
DIVIDE ( [Net Revenue] - [Net Revenue PY], [Net Revenue PY] )


// -------------------------------------------------------------- 6. SHARE ----

// A title's share of its own studio's revenue. REMOVEFILTERS on dim_title clears
// the title filter while leaving the studio filter in place, so studio context
// re-propagates through the bridge and the denominator is the studio total.
// ASSUMPTION: studio context arrives from dim_studio. If a user instead selects
// titles directly, the denominator falls back to the company total.
% of Studio Net Revenue =
DIVIDE (
    [Net Revenue],
    CALCULATE ( [Net Revenue], REMOVEFILTERS ( dim_title ) )
)
